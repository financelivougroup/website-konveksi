# Supabase — teks (PostgreSQL), Auth, dan Realtime tetap di Supabase.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Cloudflare R2 — lampiran (foto produk, bukti komplain, bukti bayar, nota).
#
# Basis URL publik. BIARKAN KOSONG untuk memakai rute baca Worker
# (`<VITE_R2_SIGN_ENDPOINT>/media/...`). Jangan diisi dengan `<bucket>.r2.dev`:
# domain itu diblokir DNS oleh sebagian ISP Indonesia ("Internet Positif"),
# sehingga semua lampiran tampak rusak. Isi hanya bila punya custom domain R2.
# VITE_R2_PUBLIC_BASE=https://cdn.<domain-kamu>
#
# URL Cloudflare Worker: penanda tangan unggah/hapus + penyaji lampiran (lihat worker/).
VITE_R2_SIGN_ENDPOINT=https://<worker-name>.<subdomain>.workers.dev
